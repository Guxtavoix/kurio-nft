# Mocks MSW (REST + Socket.IO). Ativos por padrão, inclusive no build de demonstração.
# Use "false" para apontar para um backend real.
VITE_ENABLE_MOCKS=true

# Cenário inicial dos mocks (ver README → Cenários). Vazio = "default".
VITE_MOCK_SCENARIO=

# Base da API REST (padrão: /api no mesmo domínio).
# VITE_API_URL=/api

# Origem do servidor Socket.IO (padrão: mesmo domínio). O path é /realtime/.
# VITE_SOCKET_URL=
